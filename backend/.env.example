# ==============================================================
# HƯỚNG DẪN CẤU HÌNH BIẾN MÔI TRƯỜNG CHO BACKEND (RENDER / RAILWAY)
# ==============================================================
PORT=5000
NODE_ENV=production

# Cấu hình kết nối MySQL Cloud (TiDB Cloud / Aiven / Railway)
DB_HOST=gateway01.us-west-2.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_username.root
DB_PASSWORD=your_password
DB_NAME=my_coffee_house
DB_SSL=true

# JWT Token Security (Đặt chuỗi ngẫu nhiên bảo mật)
JWT_SECRET=my_super_secret_jwt_coffee_2026_xyz123
JWT_REFRESH_SECRET=my_super_secret_refresh_coffee_2026_xyz456
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Danh sách URL Frontend được phép kết nối (Vercel)
CLIENT_URL=https://quan-ly-quan-coffee.vercel.app
ALLOWED_ORIGINS=https://quan-ly-quan-coffee.vercel.app
