# Server Configuration
PORT=5000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_db_password_here
DB_NAME=my_coffee_house

# Security & Authentication (Change these secrets in production!)
JWT_SECRET=replace_with_a_long_random_secret_for_production
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret_for_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Whitelist (Comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
